# API key secret token shared between the daemon and remote server
API_KEY=your_mock_secret_token_here

# LiteLLM configuration for remote concept map generation
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_provider_api_key_here
# LLM_API_BASE=http://localhost:11434  # Optional, base URL for self-hosted/custom endpoints
